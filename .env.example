# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/
MONGO_DB_NAME=region_france

# SOURCE
MONGO_SOURCE_CORSE_A=Haute-Corse
MONGO_SOURCE_CORSE_B=Corse-du-Sud

# SORTIE
MONGO_PIPELINE_STAGES_C=pipeline_stage_C
MONGO_REGION_SYNTHESIS=region_synthesis


MOIS_CIBLE=2026-08

# LLM
GOOGLE_AI_API_KEY=
GOOGLE_AI_API_KEY_2=
GOOGLE_AI_MODEL=gemini-3.5-flash-lite

OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# LLM order
LLM_PROVIDER=auto
LLM_PROVIDER_ORDER=google,openrouter

# Performance
BATCH_SIZE=8
PAUSE_SECONDES=2
MAX_WORKERS=1
MAX_DOCS_PER_RUN=0
MAX_LOTS_L3_PAR_DOMAINE=2

# LIMITS
RAW_TEXT_MAX_CHARS=800
RAW_TEXT_MAX_CHARS_NEWS=1200
RAW_TEXT_MAX_CHARS_GOV=1000
RAW_TEXT_MAX_CHARS_SOCIAL=400
LLM_MAX_TOKENS_OUTPUT=4500
LLM_TIMEOUT_SECONDES=45
LLM_MAX_RETRIES=3
LLM_REQUESTS_PER_MINUTE=20
LLM_TOKEN_BUDGET_DAILY=0