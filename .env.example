SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ADMIN_EMAIL=

# MongoDB
MONGO_URI=mongodb://host.docker.internal:27017/
MONGO_DB_NAME=France_Corse

# Use :80 for local/LAN HTTP; set your public domain to enable automatic HTTPS.
SITE_ADDRESS=:80

# Only needed when browsers access the API directly from another origin.
API_CORS_ORIGINS=http://localhost:5173

# obligatoire
API_KEY=

# SOURCE
MONGO_SOURCE_CORSE_A=Haute-Corse
MONGO_SOURCE_CORSE_B=Corse-du-Sud

# SORTIE
MONGO_PIPELINE_STAGES_C=Analysis_pipeline
MONGO_REGION_SYNTHESIS=Analysis_final
MONGO_RUNS=Analysis_runs
MONGO_HISTORY=Analysis_history

# Mois à analyser (format YYYY-MM, ex: 2026-08). Obligatoire si --mois non passé à main.py.
MOIS_CIBLE=global

# LLM
GOOGLE_AI_API_KEY=
GOOGLE_AI_API_KEY_2=
GOOGLE_AI_MODEL=gemini-3.5-flash-lite

OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# LLM order
LLM_PROVIDER=auto
LLM_PROVIDER_ORDER=google,openrouter

# Performance
BATCH_SIZE=8
PAUSE_SECONDES=2
MAX_WORKERS=1
MAX_DOCS_PER_RUN=0
MAX_LOTS_L3_PAR_DOMAINE=2

# LIMITS
RAW_TEXT_MAX_CHARS=800
RAW_TEXT_MAX_CHARS_NEWS=1200
RAW_TEXT_MAX_CHARS_GOV=1000
RAW_TEXT_MAX_CHARS_SOCIAL=400
LLM_MAX_TOKENS_OUTPUT=8000
LLM_TIMEOUT_SECONDES=45
LLM_MAX_RETRIES=3
LLM_REQUESTS_PER_MINUTE=20
LLM_TOKEN_BUDGET_DAILY=0